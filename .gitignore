# Dependencies
node_modules/

# Build output
dist/
web/dist/

# Secrets — never commit
.env
.env.local
.env.*.local

# Runtime data — the digest state DB is committed so the cloud runner shares
# dedupe state with local runs. Other DB files stay ignored.
*.db
!daily_automation.db
*.db-journal
*.db-wal
*.db-shm
daily_automation.db-journal
daily_automation.db-wal
daily_automation.db-shm

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
