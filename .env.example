# GITAUTO configuration — copy to .env and fill in

# Bot identity
BOT_NAME=GITAUTO

# AI provider for enrichment/summarization
#   openai - any OpenAI-compatible endpoint (default: local omniroute gateway)
#   gemini - Google Gemini via GOOGLE_API_KEY
#   none   - no model calls; use the built-in heuristics only
AI_PROVIDER=openai
AI_BASE_URL=http://127.0.0.1:3001/v1
AI_API_KEY=
AI_MODEL=auto/best-fast
AI_TIMEOUT_MS=45000

# Google Gemini key (only used when AI_PROVIDER=gemini)
GOOGLE_API_KEY=

# Delivery — every configured channel is tried independently
WEBHOOK_URL=
EMAIL_USER=
EMAIL_PASS=
# ntfy.sh topic for push notifications (optional)
NTFY_TOPIC=

# GitHub token for the search API (raises the rate limit; recommended in CI)
GITHUB_TOKEN=

# Sources and filtering
SOURCES=github,vercel,ai_skills
FETCH_LIMIT=20
MIN_STARS=30000

# Behaviour
DRY_RUN=false
CRON_SCHEDULE=0 0 * * *
