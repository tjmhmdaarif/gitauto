# GITAUTO configuration — copy to .env and fill in

# Bot identity
BOT_NAME=GITAUTO

# Google Gemini (optional — enables AI enrichment)
GOOGLE_API_KEY=

# Delivery
WEBHOOK_URL=
EMAIL_USER=
EMAIL_PASS=

# Sources and filtering
SOURCES=github,vercel,ai_skills
FETCH_LIMIT=20
MIN_STARS=30000

# Behaviour
DRY_RUN=false
CRON_SCHEDULE=0 0 * * *
